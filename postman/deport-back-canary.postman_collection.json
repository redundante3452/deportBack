    {
      "name": "API v2 - stable",
      "item": [
        {
          "name": "Listar deportistas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{STABLE_URL}}/api/v2/deportistas",
              "host": ["{{STABLE_URL}}"],
              "path": ["api", "v2", "deportistas"]
            }
          }
        },
        {
          "name": "Crear deportista",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta exitosa', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const data = pm.response.json();",
                  "const deportista = data.deportista || data;",
                  "if (deportista.id) pm.collectionVariables.set('ID', deportista.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Deportista v2\",\n  \"email\": \"deportista.v2.{{$timestamp}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{STABLE_URL}}/api/v2/deportistas",
              "host": ["{{STABLE_URL}}"],
              "path": ["api", "v2", "deportistas"]
            }
